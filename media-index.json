---
layout: null
---
{
  "version": 1,
  "files": [
    {%- assign comma = '' -%}
    {%- for file in site.static_files -%}
      {%- if file.path contains '/assets/clients/' or file.path contains '/assets/portfolio/' -%}
        {%- assign extension = file.extname | downcase -%}
        {%- if extension == '.png' or extension == '.jpg' or extension == '.jpeg' or extension == '.webp' or extension == '.avif' or extension == '.svg' or extension == '.json' or extension == '.mp4' or extension == '.webm' -%}
          {{- comma -}}{{- file.path | jsonify -}}
          {%- assign comma = ',' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}

